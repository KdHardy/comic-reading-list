# Loaded automatically by Vite/Vitest in test mode. Placeholder values only —
# tests never make real network calls to Supabase (api.ts calls are mocked or
# simply unexercised by the component/unit tests that import this module
# transitively). Do not put real credentials here.
VITE_SUPABASE_URL=https://test-project.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key
VITE_WRITE_SECRET=test-write-secret
